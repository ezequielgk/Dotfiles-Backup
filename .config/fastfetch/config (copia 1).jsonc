{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "devuan_small",
        "padding": {
            "top": 2,    // Agrega 2 líneas vacías arriba para bajar el logo y centrarlo
            "right": 4
        }
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "fqdn": false
        },
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "37",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "37"
        },
        {
            "type": "command",
            "key": "PKG ",
            "keyColor": "37",
            "text": "echo \"$(dpkg-query -l | grep '^ii' | wc -l) (dpkg)\""
        },
        {
            "type": "command",
            "key": "NIX ",
            "keyColor": "37",
            "text": "echo \"$(nix-env -q | wc -l) (user), $(ls -d /nix/store/*/ | wc -l) (nix-store)\""
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "37"
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "37",
            "format": "{1}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "██",
            "block": {
                "range": [1, 6]
            }
        },
        "break"
    ]
}
