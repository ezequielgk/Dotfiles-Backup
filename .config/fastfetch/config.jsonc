{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "right": 2 }
    },
    "display": {
        "separator": " │ "
    },
    "modules": [

        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "shell",
            "key": "SH ",
            "format": "{1}"

        },
        {
            "type": "wm",
            "key": "WM ",
            "format": "{2} ({3})"
        },
        {
            "type": "os",
            "key": "OS ",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "KER"
        },
		{
			"type": "command",
			"key": "PKG",
			"text": "echo \"$(dpkg-query -l | grep '^ii' | wc -l) (dpkg), $(home-manager packages | wc -l) (nix)\""
		}
    ]
}
